# Salin ke deploy/.env lalu isi. Dibaca Laravel (env_file di compose.yaml) dan compose (variabel MariaDB dan FE).
# Contoh di bawah untuk VPS; nilai uji laptop ada di docs/docker.md.

APP_NAME="TK Tarbiyatul Athfal 8"
APP_ENV=production
# Pakai APP_KEY lama dari instalasi sekarang. Kalau berganti, sesi dan data terenkripsi lama tidak terbaca.
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tarbiyathulathfal8.cloud
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Host "db" adalah service MariaDB di compose.yaml. Nilai DB_* juga dipakai membuat database dan user saat
# volume db pertama kali dibuat.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tkta8
DB_USERNAME=tkta8
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://tarbiyathulathfal8.cloud
# Request dari Nginx host masuk ke container lewat gateway jaringan Docker (172.16.0.0/12). IP publik VPS tetap
# ada karena FE memanggil BE lewat domain publik.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,<ip-publik-vps>

GOOGLE_CLIENT_ID=

SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Khusus compose. BE_API_URL dipakai FE saat build dan saat berjalan; GOOGLE_CLIENT_ID di atas ikut ditanam ke
# bundle FE. Mengubah keduanya berarti build ulang: docker compose up -d --build fe.
BE_API_URL=https://api.tarbiyathulathfal8.cloud/api/v1
# Folder repo FE, relatif terhadap deploy/.
FE_DIR=../../fe
BE_PORT=8000

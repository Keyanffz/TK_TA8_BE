includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    # casts() model dibaca dari isinya, bukan dari PHPDoc array<string, string>,
    # supaya kolom enum/datetime bertipe benar.
    parseModelCastsMethod: true
